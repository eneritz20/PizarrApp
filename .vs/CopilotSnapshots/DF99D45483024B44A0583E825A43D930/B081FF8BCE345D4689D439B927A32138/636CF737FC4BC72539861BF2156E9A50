using System;
using System.Collections.ObjectModel;
using Microsoft.Maui.Controls;
using PizarrApp.Model.ClaseTarea;

namespace PizarrApp
{
    public partial class TareasPage : ContentPage
    {
      
        public ObservableCollection<Tarea> ListaTareas { get; set; }

        public TareasPage()
        {
            InitializeComponent();

            ListaTareas = new ObservableCollection<Tarea>
            {
                new Tarea { Nombre = "Sacar la basura", Completada = false },
                new Tarea { Nombre = "Limpiar cocina", Completada = false },
                new Tarea { Nombre = "Poner lavadora", Completada = false }
            };

          
            TareasCollectionView.ItemsSource = ListaTareas;
        }

        private async void OnAgregarTareaClicked(object sender, EventArgs e)
        {
            string nombreTarea = TareaEntry.Text?.Trim();

           
            if (string.IsNullOrEmpty(nombreTarea))
            {
                await DisplayAlert("Campo Obligatorio", "El nombre de la tarea no puede estar vacío.", "Aceptar");
                return;
            }

            ListaTareas.Add(new Tarea 
            { 
                Nombre = nombreTarea, 
                Completada = false 
            });

            TareaEntry.Text = string.Empty;
        }
    }
}
