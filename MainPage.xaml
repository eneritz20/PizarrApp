<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizarrApp.MainPage"
             Shell.NavBarIsVisible="False"
             Background="#D8E6FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center">

            <Image
                Source="pizarrap_logo.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label
                Text="¡Bienvenido a PizarrApp!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <!--
            <Label
                Text="Por favor, elige una lista."
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="" />
            -->

            <Button
                x:Name="CompraButton"
                Text="Lista de la compra" 
                SemanticProperties.Hint="Accede a la lista de la compra"
                Clicked="OnCompraClicked"
                BackgroundColor="#3A86FF"
                HeightRequest="20"
                HorizontalOptions="Fill"
                ImageSource="icono_carro_blanco.png"/>

            <Button
                x:Name="TareasButton"
                Text="Lista de tareas"
                BackgroundColor="#38B000"
                SemanticProperties.Hint="Accede a la lista de tareas"
                Clicked="OnTareasClicked"
                HeightRequest="20"
                HorizontalOptions="Fill"
                ImageSource="icono_lista_blanca.png" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
